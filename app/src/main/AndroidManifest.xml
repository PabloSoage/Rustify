<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="ForegroundServicePermission">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:ignore="all" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Voice control (speech recognition). Requested at runtime. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Travel playlist: current location to compute the route/ETA. Requested at runtime. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- In-app updater: install the downloaded APK via the system package installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Android 11+ package visibility: without this, setPackage("com.google.android.apps.maps") and
         resolving activities for http/geo are invisible, so the "Open in Google Maps" button opens
         nothing. Declares that we query apps handling VIEW http(s)/geo and the Maps package. -->
    <queries>
        <package android:name="com.google.android.apps.maps" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <!-- Discover APK installers (system installer, Install With Options/Shizuku, SAI, …) for the
             in-app updater on Android 11+ (package visibility). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/rustify"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/rustify_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Rustify">
        <!-- Android Auto: declare the media browse capability. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|locale|layoutDirection"
            android:theme="@style/Theme.Rustify">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep links for Spotify URLs (all entity types + intl-). -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="open.spotify.com" />
                <data android:pathPrefix="/track/" />
                <data android:pathPrefix="/album/" />
                <data android:pathPrefix="/playlist/" />
                <data android:pathPrefix="/artist/" />
                <data android:pathPrefix="/intl-" />
            </intent-filter>

            <!-- YouTube Music deep links. autoVerify="false": these are not our own domains (not
                 verifiable App Links), just open-in-app deep links. Separate <data> attributes
                 (scheme/host/path) keep the same semantics without the "split data tag" warning. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- Scope to real YTM entities so we don't hijack every music.youtube.com URL. -->
                <data android:scheme="https" />
                <data android:host="music.youtube.com" />
                <data android:pathPrefix="/watch" />
                <data android:pathPrefix="/playlist" />
                <data android:pathPrefix="/browse" />
                <data android:pathPrefix="/channel" />
            </intent-filter>
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="youtu.be" />
            </intent-filter>
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="www.youtube.com" />
                <data android:pathPrefix="/watch" />
            </intent-filter>

            <!-- Verifiable Rustify wrapper App Links.
                 Each host MUST serve https://<host>/.well-known/assetlinks.json with the signature's
                 SHA-256 fingerprint. Without that JSON, autoVerify simply does not verify.
                 The host is fixed at build time (not runtime).
                 Hosts are kept in sync with util/AppLinksHosts.kt — add/remove in both places. -->

            <!-- rustify-music.github.io (project organization) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="rustify-music.github.io" android:pathPrefix="/r" />
            </intent-filter>

            <!-- pablosoage.github.io (maintainer's personal domain) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="pablosoage.github.io" android:pathPrefix="/r" />
            </intent-filter>

            <!-- Reference placeholder (does NOT verify: rustify.example.com does not exist). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="rustify.example.com" android:pathPrefix="/r" />
            </intent-filter>

            <!-- Fallback without strong verification (any app can claim the scheme).
                 Registers rustify:// so the extractDeepLink branch is reachable. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="rustify" />
            </intent-filter>

            <!-- Share Target: intercept shared Spotify links from other apps -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Intercept geo: links (Android standard) and Google Maps URLs. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="geo" />
            </intent-filter>
        </activity>

        <service
            android:name=".player.RustifyForegroundService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService"/>
                <action android:name="androidx.media3.session.MediaSessionService"/>
                <!-- Android Auto / legacy media browsers connect via MediaBrowserService. -->
                <action android:name="android.media.browse.MediaBrowserService"/>
            </intent-filter>
        </service>

        <!-- AppAuth OAuth redirect. Uses an HTTPS App Link on our already-verified
             domain (same host as the /r/ share links) so the OAuth client is NOT tied to the APK
             signing certificate; one client works on any build. Requires an assetlinks.json on the
             host and https://rustify-music.github.io/oauth2redirect to exist (a blank page is fine).
             tools:node="replace" overrides AppAuth's default custom-scheme intent-filter. -->
        <activity
            android:name="net.openid.appauth.RedirectUriReceiverActivity"
            android:exported="true"
            tools:node="replace">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                    android:host="rustify-music.github.io"
                    android:pathPrefix="/oauth2redirect" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                    android:host="pablosoage.github.io"
                    android:pathPrefix="/oauth2redirect" />
            </intent-filter>
        </activity>

        <!-- FileProvider that exposes local cover art (filesDir/covers) to other processes (e.g. the
             Android Auto renderer, which runs in its own process and can't read our private storage via
             file://). Maps covers/ to a temporary content:// URI with read permission. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.varuna.rustify.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>